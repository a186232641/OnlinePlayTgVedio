# --- GHCR images (used by deploy/docker-compose.prod.yml) ---
IMAGE_OWNER=a186232641
IMAGE_TAG=latest

# --- Telegram API credentials (get from https://my.telegram.org) ---
TG_API_ID=0
TG_API_HASH=

# --- Server ---
SERVER_ADDR=:8080
DOMAIN=localhost

# --- Database ---
POSTGRES_DB=tgvideo
POSTGRES_USER=tgvideo
POSTGRES_PASSWORD=change_me_in_prod
DB_DSN=postgres://tgvideo:change_me_in_prod@postgres:5432/tgvideo?sslmode=disable

# --- Secrets (32-byte base64 each; generate via: openssl rand -base64 32) ---
JWT_SECRET=replace_with_openssl_rand_base64_32
MASTER_KEY=replace_with_openssl_rand_base64_32

# --- Cache ---
CACHE_DIR=/var/cache/tgvideo
CACHE_CAP_GB=50
