# Stage 1: build the React SPA
FROM node:20-alpine AS spa
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
RUN npm run build

# Stage 2: Caddy serving the SPA + reverse-proxying /api -> server:8080
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=spa /web/dist /srv/web
EXPOSE 80 443
