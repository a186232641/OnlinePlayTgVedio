# Stage 1: build the React SPA
FROM node:20-alpine AS spa
WORKDIR /web
COPY web/package.json web/package-lock.json* ./
RUN npm ci
COPY web/ ./
# .dockerignore strips host node_modules/dist, but be defensive
RUN rm -rf node_modules && npm ci && npm run build
# Sanity check: fail the build loudly if the SPA didn't produce assets
RUN ls /web/dist/assets/*.js >/dev/null && ls /web/dist/assets/*.css >/dev/null

# Stage 2: Caddy serving the SPA + reverse-proxying /api -> server:8080
FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=spa /web/dist /srv/web
EXPOSE 80 443
