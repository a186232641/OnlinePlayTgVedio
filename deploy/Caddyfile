# {$DOMAIN} drives auto-HTTPS:
#   - real domain (e.g. tgvideo.example.com) → Let's Encrypt cert
#   - "localhost" (default) → Caddy's internal self-signed cert
{$DOMAIN:localhost} {
	encode gzip

	# Long-cache hashed asset bundles
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# API + streaming + health → backend
	handle /api/* {
		reverse_proxy server:8080 {
			flush_interval -1
		}
	}
	handle /healthz {
		reverse_proxy server:8080
	}

	# Everything else: SPA static files with index.html fallback
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
