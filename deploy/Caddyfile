# {$DOMAIN} drives auto-HTTPS:
#   - real domain (e.g. tgvideo.example.com) → Let's Encrypt cert
#   - "localhost" (default) → Caddy's internal self-signed cert
{$DOMAIN:localhost} {
	encode gzip

	# API + streaming + health → backend
	@api path /api/* /healthz
	reverse_proxy @api server:8080 {
		# don't buffer; preserve Range / streaming
		flush_interval -1
	}

	# Static SPA: try real file, fall back to index.html for client-side routing
	root * /srv/web
	try_files {path} /index.html
	file_server
}
